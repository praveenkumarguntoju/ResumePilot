generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model University {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  opportunities Opportunity[]

  @@index([slug])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String
  planType        String    @default("free")
  role            String    @default("individual")  // "individual" | "student" | "advisor" | "admin" | "superadmin"
  universityId    String?
  isActive        Boolean   @default(true)
  isApproved      Boolean   @default(true)
  consentGiven    Boolean   @default(false)
  consentAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  university           University?          @relation(fields: [universityId], references: [id], onDelete: SetNull)
  profile              Profile?
  resumes              Resume[]
  applications         Application[]
  publicProfiles       PublicProfile[]
  interviewReadiness   InterviewReadiness[]
  commentsGiven        ResumeComment[]      @relation("AdvisorComments")
  commentsReceived     ResumeComment[]      @relation("StudentComments")
  studentOpportunities StudentOpportunity[]

  @@index([universityId])
  @@index([role])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  fullName        String?
  email           String?
  phone           String?
  rawResumeText   String?
  structuredJson  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id                 String   @id @default(cuid())
  userId             String
  jobTitle           String
  company            String
  tailoredResumeText String
  atsScore           Int?
  keywordMatch       Float?
  jobDescription     String?
  jobUrl             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicProfiles     PublicProfile[]
  interviewReadiness InterviewReadiness[]
}

model Application {
  id           String   @id @default(cuid())
  userId       String
  company      String
  role         String
  status       String   @default("applied")
  dateApplied  DateTime @default(now())
  notes        String?
  resumeId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, status])
}

model PublicProfile {
  id                  String   @id @default(cuid())
  userId              String
  resumeId            String?
  slug                String   @unique
  name                String
  headline            String
  location            String?
  resumeText          String
  shortBrief          String?
  skills              String
  experience          String
  availability        String?
  dayRate             String?
  annualSalary        String?
  jobType             String?
  visaSponsorshipReq  Boolean  @default(false)
  contactNumber       String?
  additionalNotes     String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume              Resume?  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  @@index([slug])
  @@index([userId])
  @@index([resumeId])
}

model InterviewReadiness {
  id                  String   @id @default(cuid())
  userId              String
  resumeId            String?
  targetRole          String
  resumeQualityScore  Int      @default(0)
  skillMatchScore     Int      @default(0)
  experienceScore     Int      @default(0)
  marketDemandScore   Int      @default(0)
  overallScore        Int      @default(0)
  missingSkills       String?
  weakAreas           String?
  suggestions         String?
  resumeQualityDetail String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume              Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resumeId])
}

model ChatMessage {
  id              String   @id @default(cuid())
  profileSlug     String
  question        String
  answer          String
  createdAt       DateTime @default(now())
  
  @@index([profileSlug])
}

model ResumeComment {
  id          String   @id @default(cuid())
  studentId   String
  advisorId   String
  commentText String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     User     @relation("StudentComments", fields: [studentId], references: [id], onDelete: Cascade)
  advisor     User     @relation("AdvisorComments", fields: [advisorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([advisorId])
}

model Opportunity {
  id            String   @id @default(cuid())
  universityId  String
  title         String
  description   String?
  link          String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  university    University           @relation(fields: [universityId], references: [id], onDelete: Cascade)
  students      StudentOpportunity[]

  @@index([universityId])
}

model StudentOpportunity {
  id            String   @id @default(cuid())
  studentId     String
  opportunityId String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([studentId, opportunityId])
  @@index([studentId])
  @@index([opportunityId])
}
