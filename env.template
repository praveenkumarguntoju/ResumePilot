# Database
# For local development with PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/careerpilot?schema=public"
# For production (Neon/Supabase):
DATABASE_URL="postgresql://user:password@host.region.provider.neon.tech/dbname?sslmode=require"

# NextAuth
# For local development:
NEXTAUTH_URL="http://localhost:3000"
# For production, use your Vercel URL:
# NEXTAUTH_URL="https://your-app-name.vercel.app"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# OpenAI
OPENAI_API_KEY="your-openai-api-key-here"

# Optional: Stripe (for future payment features)
# STRIPE_SECRET_KEY="your-stripe-secret-key"
# STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"
# STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"
